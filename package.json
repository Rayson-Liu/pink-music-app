{
  "name": "PinkMusic",
  "private": true,
  "version": "2.6.3",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "node scripts/dev-electron.js",
    "electron:build": "npm run build && electron-builder -mw",
    "electron:build:mac": "npm run build && electron-builder --mac",
    "electron:build:win:x64": "npm run build && electron-builder --win --x64",
    "electron:build:win:arm64": "npm run build && electron-builder --win --arm64",
    "electron:build:win:all": "npm run build && electron-builder --win --x64 --arm64",
    "electron:build:all": "npm run build && electron-builder -mw",
    "test:storage": "node scripts/test-persistent-storage.js",
    "test:playlist": "node scripts/test-playlist-migration.js",
    "test": "npm run test:storage && npm run test:playlist"
  },
  "dependencies": {
    "axios": "^1.15.2",
    "discord-rpc": "^4.0.1",
    "music-metadata": "^7.14.0",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "qrcode": "^1.5.4",
    "vue": "^3.5.32"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@vitejs/plugin-vue": "^6.0.5",
    "electron": "^20.0.0",
    "electron-builder": "^24.0.0",
    "electron-notarize": "^1.2.2",
    "vite": "^8.0.4"
  },
  "build": {
    "appId": "com.pinkmusic.app",
    "productName": "Pink Music",
    "compression": "maximum",
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      {
        "from": "dist",
        "to": "dist",
        "filter": [
          "index.html",
          "desktop_lyrics.html",
          "assets/**/*"
        ]
      },
      "pink.png"
    ],
    "afterSign": "scripts/notarize.js",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "pink.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "sign": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "pink.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Pink Music",
      "artifactName": "Pink Music-Setup-${version}-${arch}.${ext}"
    }
  }
}
